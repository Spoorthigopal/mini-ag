# ============================================================
# STU-MINI Backend — Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# ============================================================

# --------------------
# Application Settings
# --------------------
APP_NAME=StudHelper
APP_VERSION=1.0.0
DEBUG=False
LOG_LEVEL=INFO

# Allowed CORS origins (comma-separated list in production)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# --------------------
# Database
# --------------------
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/studhelper
DATABASE_ECHO=False
DATABASE_POOL_SIZE=20

# --------------------
# JWT Authentication
# --------------------
# Must be at least 32 characters long — use a strong random key!
SECRET_KEY=your-super-secret-jwt-key-must-be-at-least-32-chars-long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# --------------------
# Google Gemini API
# --------------------
GOOGLE_API_KEY=your_google_gemini_api_key_here

# --------------------
# NVIDIA NIM Embeddings
# --------------------
NVIDIA_API_KEY=your_nvidia_nim_api_key_here

# --------------------
# Pinecone Vector DB
# --------------------
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=studhelper

# --------------------
# JSearch API (RapidAPI)
# --------------------
JSEARCH_API_KEY=your_jsearch_rapidapi_key_here

# --------------------
# Google OAuth (DigiLocker)
# --------------------
GOOGLE_OAUTH_CLIENT_ID=your_google_oauth_client_id
GOOGLE_OAUTH_CLIENT_SECRET=your_google_oauth_client_secret

# --------------------
# Admin API Key
# --------------------
# Used for protected admin routes (X-API-Key header)
ADMIN_API_KEY=your_admin_api_key_here

# --------------------
# Storage
# --------------------
STORAGE_PATH=/data/digilocker
MAX_UPLOAD_SIZE=52428800
MAX_STORAGE_PER_USER=524288000

# --------------------
# Interview Settings
# --------------------
MAX_INTERVIEW_QUESTIONS=7
MAX_INTERVIEW_DURATION_HOURS=1
